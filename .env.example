PORT=3000
DOAB_API_BASE_URL=https://directory.doabooks.org/rest
DOAB_REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=100000
ENABLE_CACHE=true
CACHE_DIR=.cache/doab
CACHE_TTL_SECONDS=86400
ENABLE_MEMORY_CACHE=true
MEMORY_CACHE_MAX_ENTRIES=200
MEMORY_CACHE_TTL_SECONDS=900
MAX_RESULTS_DEFAULT=10
MAX_RESULTS_LIMIT=25
TRUST_PROXY=false
BUILD_SHA=development
DEPLOYMENT_BASE_URL=
